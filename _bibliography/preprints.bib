@article{wu2025midllm,
  abbr={Preprint},
  field={Music},
  field_badge_class={badge_music},
  abstract={We present MIDI-LLM, an LLM for generating multitrack MIDI music from free-form text prompts. Our approach expands a text LLM's vocabulary to include MIDI tokens, and uses a two-stage training recipe to endow text-to-MIDI abilities. By preserving the LLM’s weight signature, we can directly leverage the vLLM library for accelerated inference. Experiments show that MIDI-LLM achieves higher quality, better text control, and faster inference compared to the recent Text2midi model.},
  title={{MIDI-LLM}: Adapting large language models for text-to-{MIDI} music generation},
  author={Wu, Shih-Lun and Kim, Yoon and Huang, Cheng-Zhi Anna},
  journal={Under Review},
  year={2025},
  pdf={https://arxiv.org/pdf/2511.03942},
  website={https://midi-llm-demo.vercel.app/},
  code={https://github.com/slSeanWU/MIDI-LLM}
}

